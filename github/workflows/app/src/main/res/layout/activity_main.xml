
<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_studio">

    <!-- ГЛАВНЫЙ ЭКРАН -->
    <LinearLayout
        android:id="@+id/homeScreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingStart="22dp"
        android:paddingEnd="22dp"
        android:paddingTop="18dp"
        android:paddingBottom="18dp">

        <TextView
            android:id="@+id/logo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="WRAPVISION"
            android:textColor="#DCE5F0"
            android:textSize="29sp"
            android:textStyle="bold"
            android:letterSpacing="0.16"
            android:shadowColor="#4488CCFF"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="14" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="PREMIUM STUDIO"
            android:textColor="#8294A8"
            android:textSize="10sp"
            android:letterSpacing="0.28" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="10dp">

            <ImageView
                android:id="@+id/carImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/mustang_home"
                android:scaleType="fitCenter"
                android:contentDescription="Автомобиль Mustang" />

        </FrameLayout>

        <!-- ПАНЕЛЬ ВЫБРАННОГО ЦВЕТА -->
        <LinearLayout
            android:id="@+id/selectedColorPanel"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:background="@drawable/bg_panel">

            <View
                android:id="@+id/colorSwatch"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/bg_swatch" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="13dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ВЫБРАННЫЙ ЦВЕТ"
                    android:textColor="#8494A7"
                    android:textSize="9sp"
                    android:letterSpacing="0.15" />

                <TextView
                    android:id="@+id/colorCode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="#30343A"
                    android:textColor="#E8EDF4"
                    android:textSize="14sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="●"
                android:textColor="#55BFFF"
                android:textSize="15sp" />

        </LinearLayout>

        <!-- ОСНОВНАЯ КНОПКА -->
        <Button
            android:id="@+id/startPreviewButton"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="14dp"
            android:text="НАЧАТЬ ПРОСМОТР"
            android:textColor="#F1F6FC"
            android:textSize="14sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:background="@drawable/bg_button_primary"
            android:backgroundTint="@null"
            android:elevation="5dp" />

        <!-- НИЖНИЕ КНОПКИ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="10dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:weightSum="2">

            <Button
                android:id="@+id/chooseColorButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="5dp"
                android:text="ВЫБРАТЬ ЦВЕТ"
                android:textColor="#DCE5EF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.03"
                android:background="@drawable/bg_button_secondary"
                android:backgroundTint="@null"
                android:insetTop="0dp"
                android:insetBottom="0dp" />

            <Button
                android:id="@+id/projectsButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="5dp"
                android:text="МОИ ПРОЕКТЫ"
                android:textColor="#DCE5EF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.03"
                android:background="@drawable/bg_button_secondary"
                android:backgroundTint="@null"
                android:insetTop="0dp"
                android:insetBottom="0dp" />

        </LinearLayout>

    </LinearLayout>

    <!-- ЭКРАН КАМЕРЫ -->
    <FrameLayout
        android:id="@+id/cameraScreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:background="#080B10">

        <androidx.camera.view.PreviewView
            android:id="@+id/cameraPreview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:scaleType="fillCenter" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:orientation="vertical"
            android:padding="18dp"
            android:background="#CC080B10">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="WRAPVISION"
                android:textColor="#E5EDF7"
                android:textSize="21sp"
                android:textStyle="bold"
                android:letterSpacing="0.12" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="РЕЖИМ ПРОСМОТРА"
                android:textColor="#69BFFF"
                android:textSize="11sp"
                android:letterSpacing="0.15" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/cameraControls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:padding="18dp"
            android:background="#E6090C12">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ОБЛАСТЬ НАНЕСЕНИЯ"
                android:textColor="#AAB8C8"
                android:textSize="10sp"
                android:letterSpacing="0.12" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="9dp"
                android:orientation="horizontal"
                android:weightSum="2">

                <Button
                    android:id="@+id/bodyModeButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="5dp"
                    android:text="ВЕСЬ КУЗОВ"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:background="@drawable/bg_button_selected"
                    android:backgroundTint="@null"
                    android:insetTop="0dp"
                    android:insetBottom="0dp" />

                <Button
                    android:id="@+id/partsModeButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="5dp"
                    android:text="ОТДЕЛЬНЫЕ ЭЛЕМЕНТЫ"
                    android:textColor="#DCE5EF"
                    android:textSize="10sp"
                    android:background="@drawable/bg_button_secondary"
                    android:backgroundTint="@null"
                    android:insetTop="0dp"
                    android:insetBottom="0dp" />

            </LinearLayout>

            <Button
                android:id="@+id/backHomeButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:text="НАЗАД"
                android:textColor="#DCE5EF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:background="@drawable/bg_button_dark"
                android:backgroundTint="@null"
                android:insetTop="0dp"
                android:insetBottom="0dp" />

        </LinearLayout>

    </FrameLayout>

</FrameLayout>
