<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#05090F">

    <ScrollView
        android:id="@+id/homeScreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:background="@drawable/bg_home_premium">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="18dp"
            android:paddingBottom="18dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="42dp">

                <TextView
                    android:id="@+id/brandTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:text="WRAPVISION"
                    android:textColor="#E8F1FF"
                    android:textStyle="bold"
                    android:textSize="27sp"
                    android:letterSpacing="0.08"
                    android:shadowColor="#668CCFFF"
                    android:shadowDx="0"
                    android:shadowDy="0"
                    android:shadowRadius="12" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:text="⚙"
                    android:textColor="#CDEBFF"
                    android:textSize="25sp" />

            </RelativeLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="P R E M I U M   S T U D I O"
                android:textColor="#19BFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:letterSpacing="0.14"
                android:paddingBottom="18dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="ТВОЙ АВТОМОБИЛЬ."
                android:textColor="#DCE4EF"
                android:textSize="21sp"
                android:textStyle="bold"
                android:paddingTop="2dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="ТВОЙ СТИЛЬ."
                android:textColor="#16BFFF"
                android:textSize="23sp"
                android:textStyle="bold"
                android:paddingBottom="12dp" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_car_frame"
                android:padding="2dp">

                <ImageView
                    android:id="@+id/homeCarImage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:adjustViewBounds="true"
                    android:scaleType="centerCrop"
                    android:src="@drawable/mustang_home"
                    android:contentDescription="Автомобиль Mustang" />

            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="@drawable/bg_premium_panel">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="ВАШ ТЕКУЩИЙ ВЫБОР"
                    android:textColor="#DCE8F5"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.04" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingTop="12dp">

                    <View
                        android:layout_width="76dp"
                        android:layout_height="68dp"
                        android:background="@drawable/bg_color_sample" />

                    <TextView
                        android:id="@+id/homeColorInfo"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:paddingStart="16dp"
                        android:text="Цвет плёнки не выбран"
                        android:textColor="#F2F6FC"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                </LinearLayout>
            </LinearLayout>

            <Button
                android:id="@+id/startCameraButton"
                android:layout_width="match_parent"
                android:layout_height="66dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_button_primary"
                android:text="◉     НАЧАТЬ ПРОСМОТР"
                android:textColor="#07111D"
                android:textSize="18sp"
                android:textStyle="bold"
                android:stateListAnimator="@null" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:orientation="horizontal"
                android:layout_marginTop="12dp">

                <Button
                    android:id="@+id/homeSelectColorButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_button_secondary"
                    android:text="◈  ВЫБРАТЬ ЦВЕТ"
                    android:textColor="#07111D"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:stateListAnimator="@null" />

                <Button
                    android:id="@+id/myProjectsButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_button_secondary"
                    android:text="▰  МОИ ПРОЕКТЫ"
                    android:textColor="#07111D"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:stateListAnimator="@null" />

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <FrameLayout
        android:id="@+id/cameraScreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#05090F"
        android:visibility="gone">

        <androidx.camera.view.PreviewView
            android:id="@+id/cameraPreview"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="#D908101A">

            <TextView
                android:id="@+id/statusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Выберите цвет плёнки"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:padding="8dp" />

            <Button
                android:id="@+id/selectColorButton"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:background="@drawable/bg_button_primary"
                android:text="ВЫБРАТЬ ЦВЕТ"
                android:textColor="#07111D"
                android:textSize="14sp"
                android:stateListAnimator="@null" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/bodyModeButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="5dp"
                    android:minWidth="0dp"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:background="@drawable/bg_button_secondary"
                    android:text="ВЕСЬ КУЗОВ"
                    android:textColor="#07111D"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:singleLine="true"
                    android:stateListAnimator="@null" />

                <Button
                    android:id="@+id/partsModeButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="5dp"
                    android:minWidth="0dp"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:background="@drawable/bg_button_secondary"
                    android:text="ПО ДЕТАЛЯМ"
                    android:textColor="#07111D"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:singleLine="true"
                    android:stateListAnimator="@null" />

            </LinearLayout>

            <Button
                android:id="@+id/backToHomeButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_button_glow"
                android:text="НА ГЛАВНУЮ"
                android:textColor="#07111D"
                android:textSize="14sp"
                android:stateListAnimator="@null" />

        </LinearLayout>
    </FrameLayout>
</FrameLayout>

