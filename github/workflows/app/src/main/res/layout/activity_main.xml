
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#080A0D">

    <ScrollView
        android:id="@+id/homeScreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:padding="22dp"
            android:background="#080A0D">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="25dp"
                android:text="WRAPVISION"
                android:textColor="#FFFFFF"
                android:textSize="34sp"
                android:textStyle="bold"
                android:gravity="center"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="CAR COLOR STUDIO"
                android:textColor="#C2C7CE"
                android:textSize="15sp"
                android:gravity="center"
                android:layout_marginTop="5dp"/>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="270dp"
                android:layout_marginTop="25dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/mustang_home"
                    android:scaleType="centerCrop"
                    android:contentDescription="Ford Mustang Eleanor"/>

            </FrameLayout>

            <Button
                android:id="@+id/startCameraButton"
                android:layout_width="match_parent"
                android:layout_height="76dp"
                android:layout_marginTop="24dp"
                android:text="НАЧАТЬ ПРОСМОТР"
                android:textSize="19sp"
                android:textStyle="bold"
                android:textColor="#101318"
                android:backgroundTint="#DCE1E8"/>

            <Button
                android:id="@+id/homeSelectColorButton"
                android:layout_width="match_parent"
                android:layout_height="76dp"
                android:layout_marginTop="14dp"
                android:text="ВЫБРАТЬ ЦВЕТ ПЛЁНКИ"
                android:textSize="17sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#20242A"/>

            <Button
                android:id="@+id/myProjectsButton"
                android:layout_width="match_parent"
                android:layout_height="76dp"
                android:layout_marginTop="14dp"
                android:text="МОИ ПРОЕКТЫ"
                android:textSize="18sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#20242A"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="25dp"
                android:gravity="center"
                android:text="W R A P V I S I O N\nP R E M I U M  S T U D I O"
                android:textColor="#AEB5BE"
                android:textSize="12sp"/>

        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/cameraScreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#080A0D"
        android:visibility="gone">

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:text="Камера готова"
            android:textColor="#FFFFFF"
            android:textSize="16sp"/>

        <androidx.camera.view.PreviewView
            android:id="@+id/cameraPreview"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            app:implementationMode="compatible"/>

        <Button
            android:id="@+id/selectColorButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Выбрать цвет плёнки"/>

        <Button
            android:id="@+id/bodyModeButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Весь кузов"/>

        <Button
            android:id="@+id/partsModeButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Отдельные детали"/>

        <Button
            android:id="@+id/backToHomeButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="На главный экран"/>

    </LinearLayout>

</FrameLayout>
