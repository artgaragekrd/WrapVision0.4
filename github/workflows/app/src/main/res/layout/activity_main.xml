
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_studio">

    <!-- ГЛАВНЫЙ ЭКРАН -->
    <LinearLayout
        android:id="@+id/homeScreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="12dp">

        <!-- ЛОГОТИП -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingTop="4dp"
            android:paddingBottom="5dp">

            <TextView
                android:id="@+id/logo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="WRAPVISION"
                android:textColor="#EAF3FF"
                android:textSize="27sp"
                android:textStyle="bold"
                android:letterSpacing="0.17"
                android:shadowColor="#0088DDFF"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="13" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="P R E M I U M   S T U D I O"
                android:textColor="#A8BED6"
                android:textSize="10sp"
                android:letterSpacing="0.12" />

        </LinearLayout>

        <!-- АВТОМОБИЛЬ -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="8dp"
            android:foregroundGravity="center">

            <ImageView
                android:id="@+id/carImage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:adjustViewBounds="true"
                android:src="@drawable/mustang_home"
                android:scaleType="fitCenter"
                android:contentDescription="Ford Mustang Eleanor" />

        </FrameLayout>

        <!-- ВЫБРАННЫЙ ЦВЕТ -->
        <LinearLayout
            android:id="@+id/selectedColorPanel"
            android:layout_width="match_parent"
            android:layout_height="68dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="15dp"
            android:paddingEnd="15dp"
            android:background="@drawable/bg_panel"
            android:elevation="5dp">

            <View
                android:id="@+id/colorSwatch"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_swatch" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="13dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ВЫБРАННЫЙ ЦВЕТ"
                    android:textColor="#91A8C0"
                    android:textSize="10sp"
                    android:letterSpacing="0.14" />

                <TextView
                    android:id="@+id/colorCode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="#30343A"
                    android:textColor="#F0F6FF"
                    android:textSize="16sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="●"
                android:textColor="#35BFFF"
                android:textSize="19sp"
                android:shadowColor="#00A8FF"
                android:shadowRadius="9" />

        </LinearLayout>

        <!-- НАЧАТЬ ПРОСМОТР -->
        <Button
            android:id="@+id/startPreviewButton"
            android:layout_width="match_parent"
            android:layout_height="62dp"
            android:layout_marginTop="12dp"
            android:text="НАЧАТЬ ПРОСМОТР"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:letterSpacing="0.07"
            android:background="@drawable/bg_button_primary"
            android:backgroundTint="@null"
            android:elevation="7dp"
            android:insetTop="0dp"
            android:insetBottom="0dp" />

        <!-- НИЖНИЕ КНОПКИ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="10dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:weightSum="2">

            <Button
                android:id="@+id/chooseColorButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="5dp"
                android:text="ВЫБРАТЬ ЦВЕТ"
                android:textColor="#E5F0FF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.02"
                android:background="@drawable/bg_button_secondary"
                android:backgroundTint="@null"
                android:insetTop="0dp"
                android:insetBottom="0dp" />

            <Button
                android:id="@+id/projectsButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="5dp"
                android:text="МОИ ПРОЕКТЫ"
                android:textColor="#E5F0FF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.02"
                android:background="@drawable/bg_button_secondary"
                android:backgroundTint="@null"
                android:insetTop="0dp"
                android:insetBottom="0dp" />

        </LinearLayout>

    </LinearLayout>

    <!-- ЭКРАН КАМЕРЫ -->
    <FrameLayout
        android:id="@+id/cameraScreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:background="#080B10">

        <androidx.camera.view.PreviewView
            android:id="@+id/cameraPreview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:scaleType="fillCenter" />

        <!-- ЗАГОЛОВОК КАМЕРЫ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:orientation="vertical"
            android:padding="18dp"
            android:background="#DD080B10">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="WRAPVISION"
                android:textColor="#EAF3FF"
                android:textSize="21sp"
                android:textStyle="bold"
                android:letterSpacing="0.12"
                android:shadowColor="#0088DDFF"
                android:shadowRadius="8" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="РЕЖИМ ПРОСМОТРА"
                android:textColor="#55BFFF"
                android:textSize="11sp"
                android:letterSpacing="0.15" />

        </LinearLayout>

        <!-- УПРАВЛЕНИЕ КАМЕРОЙ -->
        <LinearLayout
            android:id="@+id/cameraControls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="#F0080B12">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ОБЛАСТЬ НАНЕСЕНИЯ"
                android:textColor="#AABDD2"
                android:textSize="10sp"
                android:letterSpacing="0.12" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="9dp"
                android:orientation="horizontal"
                android:weightSum="2">

                <Button
                    android:id="@+id/bodyModeButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="5dp"
                    android:text="ВЕСЬ КУЗОВ"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:background="@drawable/bg_button_selected"
                    android:backgroundTint="@null"
                    android:insetTop="0dp"
                    android:insetBottom="0dp" />

                <Button
                    android:id="@+id/partsModeButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="5dp"
                    android:text="ОТДЕЛЬНЫЕ ЭЛЕМЕНТЫ"
                    android:textColor="#DCE8F5"
                    android:textSize="10sp"
                    android:background="@drawable/bg_button_secondary"
                    android:backgroundTint="@null"
                    android:insetTop="0dp"
                    android:insetBottom="0dp" />

            </LinearLayout>

            <Button
                android:id="@+id/backHomeButton"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="11dp"
                android:text="НАЗАД"
                android:textColor="#E5F0FF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:background="@drawable/bg_button_dark"
                android:backgroundTint="@null"
                android:insetTop="0dp"
                android:insetBottom="0dp" />

        </LinearLayout>

    </FrameLayout>

</FrameLayout>
