
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#080B10">

    <ScrollView
        android:id="@+id/homeScreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:background="@drawable/bg_home_premium"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="22dp"
            android:paddingEnd="22dp"
            android:paddingTop="28dp"
            android:paddingBottom="30dp">

            <TextView
                android:id="@+id/brandTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="WRAPVISION"
                android:textColor="#E8EDF5"
                android:textSize="29sp"
                android:textStyle="bold"
                android:letterSpacing="0.22"
                android:gravity="center"
                android:shadowColor="#668ACFFF"
                android:shadowRadius="13"
                android:shadowDx="0"
                android:shadowDy="0" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="PREMIUM STUDIO"
                android:textColor="#6FADEB"
                android:textSize="10sp"
                android:letterSpacing="0.42"
                android:gravity="center"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="22dp" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="250dp"
                android:background="@drawable/bg_car_frame"
                android:padding="8dp"
                android:elevation="8dp">

                <ImageView
                    android:id="@+id/homeCarImage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/mustang_home"
                    android:scaleType="fitCenter"
                    android:adjustViewBounds="true"
                    android:contentDescription="Автомобиль Mustang" />

            </FrameLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="YOUR CAR. YOUR STYLE."
                android:textColor="#AAB8CA"
                android:textSize="11sp"
                android:letterSpacing="0.18"
                android:gravity="center"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="14dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_premium_panel"
                android:padding="16dp"
                android:layout_marginBottom="18dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="ТЕКУЩИЙ ОБРАЗЕЦ ЦВЕТА"
                    android:textColor="#8FA7C2"
                    android:textSize="10sp"
                    android:letterSpacing="0.12" />

                <TextView
                    android:id="@+id/homeColorInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Цвет не выбран"
                    android:textColor="#F0F4FA"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginTop="8dp" />

                <Button
                    android:id="@+id/homeSelectColorButton"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="14dp"
                    android:text="ВЫБРАТЬ ЦВЕТ ПЛЁНКИ"
                    android:textColor="#101820"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08"
                    android:background="@drawable/bg_button_primary"
                    android:backgroundTint="@null"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:stateListAnimator="@null" />

            </LinearLayout>

            <Button
                android:id="@+id/startCameraButton"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:text="ОТКРЫТЬ КАМЕРУ"
                android:textColor="#101820"
                android:textSize="14sp"
                android:textStyle="bold"
                android:letterSpacing="0.12"
                android:background="@drawable/bg_button_primary"
                android:backgroundTint="@null"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:stateListAnimator="@null" />

            <Button
                android:id="@+id/myProjectsButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:text="МОИ ПРОЕКТЫ"
                android:textColor="#DCE8F7"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:background="@drawable/bg_button_secondary"
                android:backgroundTint="@null"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:stateListAnimator="@null" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="AUTOMOTIVE COLOR VISUALIZATION"
                android:textColor="#53677E"
                android:textSize="9sp"
                android:letterSpacing="0.16"
                android:gravity="center"
                android:layout_marginTop="25dp" />

        </LinearLayout>
    </ScrollView>

    <FrameLayout
        android:id="@+id/cameraScreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#080B10"
        android:visibility="gone">

        <androidx.camera.view.PreviewView
            android:id="@+id/cameraPreview"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:padding="18dp"
            android:background="#E6101722">

            <TextView
                android:id="@+id/statusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Камера готова"
                android:textColor="#EAF3FF"
                android:textSize="13sp"
                android:gravity="center"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/selectColorButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="ВЫБРАТЬ ОБРАЗЕЦ ЦВЕТА"
                android:textColor="#101820"
                android:textSize="12sp"
                android:textStyle="bold"
                android:background="@drawable/bg_button_primary"
                android:backgroundTint="@null"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:stateListAnimator="@null" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:orientation="horizontal"
                android:layout_marginTop="10dp">

                <Button
                    android:id="@+id/bodyModeButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="5dp"
                    android:text="ВЕСЬ КУЗОВ"
                    android:textColor="#DCE8F7"
                    android:textSize="12sp"
                    android:background="@drawable/bg_button_secondary"
                    android:backgroundTint="@null"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:stateListAnimator="@null" />

                <Button
                    android:id="@+id/partsModeButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="5dp"
                    android:text="ПО ДЕТАЛЯМ"
                    android:textColor="#DCE8F7"
                    android:textSize="12sp"
                    android:background="@drawable/bg_button_secondary"
                    android:backgroundTint="@null"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:stateListAnimator="@null" />

            </LinearLayout>

            <Button
                android:id="@+id/backToHomeButton"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="10dp"
                android:text="НА ГЛАВНЫЙ ЭКРАН"
                android:textColor="#AFC4DD"
                android:textSize="11sp"
                android:background="@drawable/bg_button_secondary"
                android:backgroundTint="@null"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:stateListAnimator="@null" />

        </LinearLayout>

    </FrameLayout>

</FrameLayout>
