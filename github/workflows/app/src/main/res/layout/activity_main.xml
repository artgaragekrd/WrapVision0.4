
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#080B10">

    <!-- ГЛАВНЫЙ ЭКРАН -->
    <ScrollView
        android:id="@+id/homeScreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="22dp"
            android:paddingBottom="24dp"
            android:gravity="center_horizontal"
            android:background="#080B10">

            <!-- ЛОГОТИП -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="WRAPVISION"
                android:textColor="#F4F6FA"
                android:textSize="31sp"
                android:textStyle="bold"
                android:letterSpacing="0.16"
                android:gravity="center"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="PREMIUM AUTOMOTIVE STUDIO"
                android:textColor="#42BFFF"
                android:textSize="11sp"
                android:letterSpacing="0.13"
                android:gravity="center"
                android:layout_marginTop="7dp"/>

            <View
                android:layout_width="58dp"
                android:layout_height="2dp"
                android:background="#28B8FF"
                android:layout_marginTop="17dp"/>

            <!-- ЗАГОЛОВОК -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ВАШ АВТОМОБИЛЬ.\nВАШ СТИЛЬ."
                android:textColor="#FFFFFF"
                android:textSize="25sp"
                android:textStyle="bold"
                android:gravity="center"
                android:lineSpacingExtra="5dp"
                android:layout_marginTop="22dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ПРИМЕРЬТЕ НОВЫЙ ОБРАЗ СВОЕМУ АВТОМОБИЛЮ"
                android:textColor="#8997A9"
                android:textSize="10sp"
                android:gravity="center"
                android:letterSpacing="0.04"
                android:layout_marginTop="9dp"/>

            <!-- ФОТОГРАФИЯ АВТОМОБИЛЯ -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="270dp"
                android:layout_marginTop="23dp"
                android:background="@drawable/bg_premium_panel"
                android:padding="5dp"
                android:elevation="5dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/mustang_home"
                    android:scaleType="fitCenter"
                    android:background="#080B10"
                    android:contentDescription="Ford Mustang Eleanor"/>

            </FrameLayout>

            <!-- ПОДПИСЬ ПОД ФОТО -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="PREMIUM CAR VISUALIZATION"
                android:textColor="#42BFFF"
                android:textSize="10sp"
                android:letterSpacing="0.12"
                android:gravity="center"
                android:layout_marginTop="15dp"/>

            <!-- ИНФОРМАЦИЯ О ПЛЁНКЕ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_premium_panel"
                android:padding="16dp"
                android:layout_marginTop="19dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="ВАШ ТЕКУЩИЙ ВЫБОР"
                    android:textColor="#42BFFF"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08"/>

                <TextView
                    android:id="@+id/homeColorInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Цвет плёнки ещё не выбран"
                    android:textColor="#E8EDF4"
                    android:textSize="14sp"
                    android:layout_marginTop="9dp"/>

            </LinearLayout>

            <!-- ОСНОВНЫЕ КНОПКИ -->
            <Button
                android:id="@+id/startCameraButton"
                android:layout_width="match_parent"
                android:layout_height="66dp"
                android:layout_marginTop="22dp"
                android:text="НАЧАТЬ ПРОСМОТР"
                android:textAllCaps="false"
                android:textColor="#101820"
                android:textSize="17sp"
                android:textStyle="bold"
                android:gravity="center"
                android:background="@drawable/bg_button_primary"
                android:backgroundTint="@null"
                android:elevation="5dp"/>

            <Button
                android:id="@+id/homeSelectColorButton"
                android:layout_width="match_parent"
                android:layout_height="66dp"
                android:layout_marginTop="13dp"
                android:text="ВЫБРАТЬ ЦВЕТ ПЛЁНКИ"
                android:textAllCaps="false"
                android:textColor="#101820"
                android:textSize="15sp"
                android:textStyle="bold"
                android:gravity="center"
                android:background="@drawable/bg_button_primary"
                android:backgroundTint="@null"/>

            <Button
                android:id="@+id/myProjectsButton"
                android:layout_width="match_parent"
                android:layout_height="66dp"
                android:layout_marginTop="13dp"
                android:text="МОИ ПРОЕКТЫ"
                android:textAllCaps="false"
                android:textColor="#101820"
                android:textSize="16sp"
                android:textStyle="bold"
                android:gravity="center"
                android:background="@drawable/bg_button_primary"
                android:backgroundTint="@null"/>

            <!-- НИЖНЯЯ ПОДПИСЬ -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#263443"
                android:layout_marginTop="26dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="DESIGNED FOR AUTOMOTIVE PROFESSIONALS"
                android:textColor="#657386"
                android:textSize="9sp"
                android:letterSpacing="0.08"
                android:gravity="center"
                android:layout_marginTop="17dp"
                android:layout_marginBottom="8dp"/>

        </LinearLayout>
    </ScrollView>

    <!-- ЭКРАН КАМЕРЫ -->
    <LinearLayout
        android:id="@+id/cameraScreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#080B10"
        android:visibility="gone">

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="14dp"
            android:text="Камера готова"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:background="#151C26"/>

        <androidx.camera.view.PreviewView
            android:id="@+id/cameraPreview"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            app:implementationMode="compatible"/>

        <Button
            android:id="@+id/selectColorButton"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_margin="8dp"
            android:text="ВЫБРАТЬ ЦВЕТ ПЛЁНКИ"
            android:textAllCaps="false"
            android:textColor="#101820"
            android:textSize="15sp"
            android:textStyle="bold"
            android:background="@drawable/bg_button_primary"
            android:backgroundTint="@null"/>

        <Button
            android:id="@+id/bodyModeButton"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_margin="6dp"
            android:text="ВЕСЬ КУЗОВ"
            android:textAllCaps="false"
            android:textColor="#101820"
            android:textSize="15sp"
            android:textStyle="bold"
            android:background="@drawable/bg_button_primary"
            android:backgroundTint="@null"/>

        <Button
            android:id="@+id/partsModeButton"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_margin="6dp"
            android:text="ОТДЕЛЬНЫЕ ДЕТАЛИ"
            android:textAllCaps="false"
            android:textColor="#101820"
            android:textSize="15sp"
            android:textStyle="bold"
            android:background="@drawable/bg_button_primary"
            android:backgroundTint="@null"/>

        <Button
            android:id="@+id/backToHomeButton"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_margin="8dp"
            android:text="НА ГЛАВНЫЙ ЭКРАН"
            android:textAllCaps="false"
            android:textColor="#101820"
            android:textSize="15sp"
            android:textStyle="bold"
            android:background="@drawable/bg_button_primary"
            android:backgroundTint="@null"/>

    </LinearLayout>

</FrameLayout>
