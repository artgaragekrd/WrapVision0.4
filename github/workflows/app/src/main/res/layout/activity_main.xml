
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#080B10">

    <ScrollView
        android:id="@+id/homeScreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:gravity="center_horizontal"
            android:background="#080B10">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="WRAPVISION"
                android:textColor="#F3F6FA"
                android:textSize="30sp"
                android:textStyle="bold"
                android:letterSpacing="0.16"
                android:gravity="center"
                android:layout_marginTop="20dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="P R E M I U M   A U T O M O T I V E   S T U D I O"
                android:textColor="#42BFFF"
                android:textSize="10sp"
                android:gravity="center"
                android:layout_marginTop="8dp"/>

            <View
                android:layout_width="65dp"
                android:layout_height="2dp"
                android:background="#28B8FF"
                android:layout_marginTop="18dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ВАШ АВТОМОБИЛЬ.\nВАШ СТИЛЬ."
                android:textColor="#FFFFFF"
                android:textSize="25sp"
                android:textStyle="bold"
                android:gravity="center"
                android:lineSpacingExtra="4dp"
                android:layout_marginTop="25dp"/>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="260dp"
                android:layout_marginTop="22dp"
                android:background="@drawable/bg_premium_panel"
                android:padding="5dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/mustang_home"
                    android:scaleType="fitCenter"
                    android:background="#080B10"
                    android:contentDescription="Ford Mustang Eleanor"/>

            </FrameLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ПРОФЕССИОНАЛЬНАЯ ВИЗУАЛИЗАЦИЯ ОКЛЕЙКИ"
                android:textColor="#9BAABC"
                android:textSize="11sp"
                android:gravity="center"
                android:letterSpacing="0.08"
                android:layout_marginTop="17dp"/>

            <Button
                android:id="@+id/startCameraButton"
                android:layout_width="match_parent"
                android:layout_height="66dp"
                android:layout_marginTop="25dp"
                android:text="НАЧАТЬ ПРОСМОТР"
                android:textColor="#101820"
                android:textSize="16sp"
                android:textStyle="bold"
                android:letterSpacing="0.06"
                android:background="@drawable/bg_button_primary"
                android:backgroundTint="@null"
                android:elevation="5dp"/>

            <Button
                android:id="@+id/homeSelectColorButton"
                android:layout_width="match_parent"
                android:layout_height="66dp"
                android:layout_marginTop="13dp"
                android:text="ВЫБРАТЬ ЦВЕТ ПЛЁНКИ"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:background="@drawable/bg_button_secondary"
                android:backgroundTint="@null"/>

            <Button
                android:id="@+id/myProjectsButton"
                android:layout_width="match_parent"
                android:layout_height="66dp"
                android:layout_marginTop="13dp"
                android:text="МОИ ПРОЕКТЫ"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:background="@drawable/bg_button_glow"
                android:backgroundTint="@null"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="DESIGNED FOR AUTOMOTIVE PROFESSIONALS"
                android:textColor="#657386"
                android:textSize="9sp"
                android:gravity="center"
                android:letterSpacing="0.12"
                android:layout_marginTop="30dp"
                android:layout_marginBottom="20dp"/>

        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/cameraScreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#080B10"
        android:visibility="gone">

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="14dp"
            android:text="Камера готова"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:background="#151C26"/>

        <androidx.camera.view.PreviewView
            android:id="@+id/cameraPreview"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            app:implementationMode="compatible"/>

        <Button
            android:id="@+id/selectColorButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="8dp"
            android:text="Выбрать цвет плёнки"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_button_secondary"
            android:backgroundTint="@null"/>

        <Button
            android:id="@+id/bodyModeButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="6dp"
            android:text="Весь кузов"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_button_glow"
            android:backgroundTint="@null"/>

        <Button
            android:id="@+id/partsModeButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="6dp"
            android:text="Отдельные детали"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_button_secondary"
            android:backgroundTint="@null"/>

        <Button
            android:id="@+id/backToHomeButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="8dp"
            android:text="На главный экран"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_button_secondary"
            android:backgroundTint="@null"/>

    </LinearLayout>

</FrameLayout>
