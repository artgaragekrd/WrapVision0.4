
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@drawable/bg_studio">

    <!-- ГЛАВНЫЙ ЭКРАН -->
    <LinearLayout
        android:id="@+id/homeScreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="5dp"
        android:paddingBottom="12dp">

        <!-- ЭМБЛЕМА W -->
        <TextView
            android:id="@+id/logoEmblem"
            android:layout_width="wrap_content"
            android:layout_height="57dp"
            android:text="W"
            android:gravity="center"
            android:textColor="#EAF5FF"
            android:textSize="53sp"
            android:textStyle="bold"
            android:shadowColor="#168BFF"
            android:shadowRadius="16"
            android:letterSpacing="0.04" />

        <!-- ЛОГОТИП -->
        <TextView
            android:id="@+id/logo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="WRAPVISION"
            android:textColor="#EAF3FF"
            android:textSize="30sp"
            android:textStyle="bold"
            android:letterSpacing="0.10"
            android:shadowColor="#62B9FF"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="12" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="P R E M I U M   S T U D I O"
            android:textColor="#B8D5F5"
            android:textSize="11sp"
            android:letterSpacing="0.16" />

        <!-- АВТОМОБИЛЬ -->
        <FrameLayout
            android:id="@+id/carContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:clipChildren="false"
            android:clipToPadding="false">

            <ImageView
                android:id="@+id/carImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:src="@drawable/mustang_home"
                android:scaleType="centerInside"
                android:adjustViewBounds="true"
                android:background="@android:color/transparent"
                android:contentDescription="Ford Mustang Eleanor" />

        </FrameLayout>

        <!-- ПАНЕЛЬ ВЫБРАННОГО ЦВЕТА -->
        <LinearLayout
            android:id="@+id/selectedColorPanel"
            android:layout_width="match_parent"
            android:layout_height="82dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="17dp"
            android:background="@drawable/bg_panel"
            android:elevation="7dp">

            <View
                android:id="@+id/colorSwatch"
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:background="@drawable/bg_swatch" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="15dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ВЫБРАННЫЙ ЦВЕТ"
                    android:textColor="#B6D0EA"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.10" />

                <TextView
                    android:id="@+id/colorCode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="#30343A"
                    android:textColor="#FFFFFF"
                    android:textSize="23sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="●"
                android:textColor="#19B9FF"
                android:textSize="27sp"
                android:shadowColor="#00A8FF"
                android:shadowRadius="13" />

        </LinearLayout>

        <!-- ОСНОВНАЯ КНОПКА КАМЕРЫ -->
        <Button
            android:id="@+id/startPreviewButton"
            android:layout_width="match_parent"
            android:layout_height="76dp"
            android:layout_marginTop="15dp"
            android:text="НАЧАТЬ ПРОСМОТР"
            android:textColor="#FFFFFF"
            android:textSize="19sp"
            android:textStyle="bold"
            android:letterSpacing="0.04"
            android:drawableStart="@android:drawable/ic_menu_camera"
            android:drawablePadding="17dp"
            android:drawableTint="#35C9FF"
            android:gravity="center"
            android:background="@drawable/bg_button_primary"
            android:backgroundTint="@null"
            android:elevation="9dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp" />

        <!-- НИЖНИЕ КНОПКИ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="68dp"
            android:layout_marginTop="13dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:weightSum="2">

            <Button
                android:id="@+id/chooseColorButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="7dp"
                android:text="ВЫБРАТЬ ЦВЕТ"
                android:textColor="#F0F6FF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:drawableStart="@android:drawable/ic_menu_gallery"
                android:drawablePadding="7dp"
                android:drawableTint="#B9D9FF"
                android:gravity="center"
                android:background="@drawable/bg_button_secondary"
                android:backgroundTint="@null"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingStart="5dp"
                android:paddingEnd="5dp" />

            <Button
                android:id="@+id/projectsButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="7dp"
                android:text="МОИ ПРОЕКТЫ"
                android:textColor="#F0F6FF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:drawableStart="@android:drawable/ic_menu_agenda"
                android:drawablePadding="7dp"
                android:drawableTint="#B9D9FF"
                android:gravity="center"
                android:background="@drawable/bg_button_secondary"
                android:backgroundTint="@null"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingStart="5dp"
                android:paddingEnd="5dp" />

        </LinearLayout>

    </LinearLayout>

    <!-- ЭКРАН КАМЕРЫ -->
    <FrameLayout
        android:id="@+id/cameraScreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:background="#050A12">

        <androidx.camera.view.PreviewView
            android:id="@+id/cameraPreview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:scaleType="fillCenter" />

        <!-- ЗАГОЛОВОК КАМЕРЫ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:orientation="vertical"
            android:padding="18dp"
            android:background="#E6080D18">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="WRAPVISION"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                android:textStyle="bold"
                android:letterSpacing="0.12"
                android:shadowColor="#168BFF"
                android:shadowRadius="9" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="РЕЖИМ ПРОСМОТРА"
                android:textColor="#35C5FF"
                android:textSize="12sp"
                android:letterSpacing="0.15" />

        </LinearLayout>

        <!-- УПРАВЛЕНИЕ КАМЕРОЙ -->
        <LinearLayout
            android:id="@+id/cameraControls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="#F0080D18">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ОБЛАСТЬ НАНЕСЕНИЯ"
                android:textColor="#B6D0EA"
                android:textSize="12sp"
                android:letterSpacing="0.12" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="10dp"
                android:orientation="horizontal"
                android:weightSum="2">

                <Button
                    android:id="@+id/bodyModeButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="5dp"
                    android:text="ВЕСЬ КУЗОВ"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_button_selected"
                    android:backgroundTint="@null"
                    android:insetTop="0dp"
                    android:insetBottom="0dp" />

                <Button
                    android:id="@+id/partsModeButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="5dp"
                    android:text="ОТДЕЛЬНЫЕ ЭЛЕМЕНТЫ"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:background="@drawable/bg_button_secondary"
                    android:backgroundTint="@null"
                    android:insetTop="0dp"
                    android:insetBottom="0dp" />

            </LinearLayout>

            <Button
                android:id="@+id/backHomeButton"
                android:layout_width="match_parent"
                android:layout_height="53dp"
                android:layout_marginTop="12dp"
                android:text="НАЗАД"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:background="@drawable/bg_button_dark"
                android:backgroundTint="@null"
                android:insetTop="0dp"
                android:insetBottom="0dp" />

        </LinearLayout>

    </FrameLayout>

</FrameLayout>
