<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- ГЛУБОКИЙ ТИТАН -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="13dp"/>
            <gradient
                android:type="linear"
                android:angle="90"
                android:startColor="#66727E"
                android:endColor="#46515D"/>
            <stroke
                android:width="1dp"
                android:color="#B8C3CD"/>
        </shape>
    </item>

    <!-- ТОНКАЯ ВНУТРЕННЯЯ ОКАНТОВКА -->
    <item
        android:left="2dp"
        android:top="2dp"
        android:right="2dp"
        android:bottom="2dp">

        <shape android:shape="rectangle">
            <corners android:radius="11dp"/>
            <stroke
                android:width="1dp"
                android:color="#30FFFFFF"/>
        </shape>
    </item>

    <!-- ТОНКИЙ ВЕРХНИЙ БЛИК -->
    <item
        android:left="14dp"
        android:right="14dp"
        android:top="3dp"
        android:height="1dp"
        android:gravity="top">

        <shape android:shape="rectangle">
            <solid android:color="#40FFFFFF"/>
        </shape>
    </item>

    <!-- НИЖНИЙ ТЁМНЫЙ КАНТ -->
    <item
        android:left="14dp"
        android:right="14dp"
        android:bottom="3dp"
        android:height="1dp"
        android:gravity="bottom">

        <shape android:shape="rectangle">
            <solid android:color="#35404B"/>
        </shape>
    </item>

</layer-list>
