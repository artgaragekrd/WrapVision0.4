<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- ОСНОВА: ТИТАНОВЫЙ МЕТАЛЛ -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="14dp"/>
            <gradient
                android:angle="90"
                android:startColor="#77838E"
                android:centerColor="#B6C0C9"
                android:endColor="#707D89"/>
            <stroke
                android:width="2dp"
                android:color="#E0E6EB"/>
        </shape>
    </item>

    <!-- ТОНКИЕ ЛИНИИ ШЛИФОВКИ -->
    <item android:top="7dp">
        <shape android:shape="rectangle">
            <size android:height="1dp"/>
            <solid android:color="#35FFFFFF"/>
        </shape>
    </item>

    <item android:top="11dp">
        <shape android:shape="rectangle">
            <size android:height="1dp"/>
            <solid android:color="#22FFFFFF"/>
        </shape>
    </item>

    <item android:top="16dp">
        <shape android:shape="rectangle">
            <size android:height="1dp"/>
            <solid android:color="#30FFFFFF"/>
        </shape>
    </item>

    <item android:top="21dp">
        <shape android:shape="rectangle">
            <size android:height="1dp"/>
            <solid android:color="#20FFFFFF"/>
        </shape>
    </item>

    <!-- НИЖНЯЯ МЕТАЛЛИЧЕСКАЯ ТЕНЬ -->
    <item android:gravity="bottom">
        <shape android:shape="rectangle">
            <size android:height="2dp"/>
            <solid android:color="#52616D"/>
        </shape>
    </item>

</layer-list>
