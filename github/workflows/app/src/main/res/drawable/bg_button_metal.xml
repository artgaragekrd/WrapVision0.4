<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- ОСНОВНАЯ ПОВЕРХНОСТЬ DARK TITANIUM -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="13dp"/>

            <gradient
                android:type="linear"
                android:angle="90"
                android:startColor="#66727E"
                android:centerColor="#596571"
                android:endColor="#46515D"/>

            <!-- ОДНА ТОНКАЯ МЕТАЛЛИЧЕСКАЯ РАМКА -->
            <stroke
                android:width="1dp"
                android:color="#87939E"/>
        </shape>
    </item>

    <!-- МЯГКИЙ ВЕРХНИЙ МЕТАЛЛИЧЕСКИЙ БЛИК -->
    <item
        android:left="15dp"
        android:right="15dp"
        android:top="3dp"
        android:height="1dp"
        android:gravity="top">

        <shape android:shape="rectangle">
            <solid android:color="#35FFFFFF"/>
        </shape>
    </item>

</layer-list>
