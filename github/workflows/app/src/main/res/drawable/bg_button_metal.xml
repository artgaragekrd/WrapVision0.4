<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="rectangle">
            <corners android:radius="13dp"/>

            <gradient
                android:type="linear"
                android:angle="90"
                android:startColor="#66727E"
                android:centerColor="#596571"
                android:endColor="#46515D"/>

            <stroke
                android:width="1dp"
                android:color="#87939E"/>
        </shape>
    </item>

</layer-list>
