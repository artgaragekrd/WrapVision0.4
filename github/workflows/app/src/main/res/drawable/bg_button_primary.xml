<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- НАЖАТАЯ КНОПКА -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <gradient
                android:angle="90"
                android:startColor="#AEB9C4"
                android:centerColor="#C3CCD5"
                android:endColor="#9DA9B5" />
            <stroke
                android:width="2dp"
                android:color="#E5EBF0" />
        </shape>
    </item>

    <!-- ЕДИНЫЙ СЕРЕБРИСТЫЙ СТИЛЬ -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <gradient
                android:angle="90"
                android:startColor="#E0E5EA"
                android:centerColor="#C5CED7"
                android:endColor="#AEB9C4" />
            <stroke
                android:width="2dp"
                android:color="#F2F5F8" />
        </shape>
    </item>

</selector>
