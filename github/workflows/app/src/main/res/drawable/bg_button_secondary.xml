<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="13dp"/>
            <gradient
                android:angle="270"
                android:startColor="#606B75"
                android:centerColor="#858F99"
                android:endColor="#414B55"/>
            <stroke
                android:width="1.5dp"
                android:color="#D7E0E7"/>
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <corners android:radius="13dp"/>
            <gradient
                android:angle="270"
                android:startColor="#DDE3E8"
                android:centerColor="#89949E"
                android:endColor="#414B55"/>
            <stroke
                android:width="1.5dp"
                android:color="#C7D1D9"/>
        </shape>
    </item>

</selector>
