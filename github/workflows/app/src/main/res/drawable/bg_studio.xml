<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#02050B"
                android:centerColor="#101D2B"
                android:endColor="#02060D" />
        </shape>
    </item>

    <item android:gravity="top">
        <shape android:shape="rectangle">
            <size android:height="240dp" />
            <gradient
                android:type="radial"
                android:gradientRadius="260dp"
                android:centerX="50%"
                android:centerY="50%"
                android:centerColor="#163B68"
                android:endColor="#00000000" />
        </shape>
    </item>

    <item android:gravity="bottom">
        <shape android:shape="rectangle">
            <size android:height="250dp" />
            <gradient
                android:type="radial"
                android:gradientRadius="240dp"
                android:centerX="50%"
                android:centerY="50%"
                android:centerColor="#123D65"
                android:endColor="#00000000" />
        </shape>
    </item>

</layer-list>
