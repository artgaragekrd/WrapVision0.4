
<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="90"
                android:startColor="#030508"
                android:centerColor="#101923"
                android:endColor="#020306" />
        </shape>
    </item>

    <item android:gravity="bottom" android:height="220dp">
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="90"
                android:startColor="#001C3448"
                android:centerColor="#18334B"
                android:endColor="#020407" />
        </shape>
    </item>

    <item android:gravity="left" android:width="5dp">
        <shape android:shape="rectangle">
            <solid android:color="#1766BFFF" />
        </shape>
    </item>

    <item android:gravity="right" android:width="5dp">
        <shape android:shape="rectangle">
            <solid android:color="#1766BFFF" />
        </shape>
    </item>

</layer-list>
