<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape>
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#02050A"
                android:centerColor="#101A29"
                android:endColor="#020409"/>
        </shape>
    </item>

    <item>
        <shape>
            <gradient
                android:type="radial"
                android:centerX="50%"
                android:centerY="78%"
                android:gradientRadius="340dp"
                android:startColor="#303B8EFF"
                android:endColor="#00030A16"/>
        </shape>
    </item>

    <item>
        <shape>
            <gradient
                android:type="radial"
                android:centerX="5%"
                android:centerY="48%"
                android:gradientRadius="220dp"
                android:startColor="#173B8DFF"
                android:endColor="#00030A16"/>
        </shape>
    </item>

</layer-list>
