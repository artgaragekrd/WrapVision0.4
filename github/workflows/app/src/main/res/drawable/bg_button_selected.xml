<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="16dp"/>
            <gradient
                android:angle="90"
                android:startColor="#778592"
                android:centerColor="#A3AFBA"
                android:endColor="#687682"/>
            <stroke
                android:width="2dp"
                android:color="#D5DDE4"/>
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp"/>
            <gradient
                android:angle="90"
                android:startColor="#AAB6C1"
                android:centerColor="#D0D8DF"
                android:endColor="#929FAA"/>
            <stroke
                android:width="2dp"
                android:color="#E5EBF0"/>
        </shape>
    </item>

</selector>
