<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="rectangle">
            <solid android:color="#102B48" />
            <corners android:radius="28dp" />
        </shape>
    </item>

    <item android:bottom="2dp">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#EAF5FF"
                android:centerColor="#AFC8E2"
                android:endColor="#6685A5"
                android:angle="90" />

            <corners android:radius="26dp" />

            <stroke
                android:width="1dp"
                android:color="#70BFFF" />
        </shape>
    </item>

</layer-list>

