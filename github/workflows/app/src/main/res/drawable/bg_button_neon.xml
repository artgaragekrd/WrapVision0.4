<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="rectangle">
            <corners android:radius="20dp"/>

            <gradient
                android:type="linear"
                android:angle="90"
                android:startColor="#172B43"
                android:centerColor="#102238"
                android:endColor="#0B192B"/>

            <stroke
                android:width="1.5dp"
                android:color="#20B8FF"/>
        </shape>
    </item>

    <item
        android:left="2dp"
        android:top="2dp"
        android:right="2dp"
        android:bottom="2dp">

        <shape android:shape="rectangle">
            <corners android:radius="18dp"/>
            <stroke
                android:width="0.7dp"
                android:color="#2538BFFF"/>
        </shape>
    </item>

</layer-list>
